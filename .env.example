# Path to the SQLite database file
DATABASE_PATH=/data/chronicals.db

# Public-facing origin URL (used by SvelteKit for CSRF protection)
ORIGIN=http://localhost:3000

# Extra host names the server answers to, comma-separated (e.g. the name a reverse
# proxy forwards). The ORIGIN host, localhost and IP addresses are always allowed.
ALLOWED_HOSTS=

# Server port
PORT=3000

# Largest accepted request body. Backups are uploaded as one request (max 50 MB).
BODY_SIZE_LIMIT=50M
