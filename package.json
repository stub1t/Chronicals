		"@types/sql.js": "^1.4.11",
		"@types/uuid": "^10.0.0",
		"autoprefixer": "^10.6.1",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.5.30",
		"sql.js": "^1.14.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.4"
	},
	"dependencies": {
