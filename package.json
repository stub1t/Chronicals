{
	"name": "chronicals",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:mobile": "CHRONICALS_TARGET=mobile vite build",
		"android:sync": "npm run build:mobile && cap sync android",
		"android:open": "cap open android",
		"release": "gh workflow run android-release.yml --ref main && echo 'Started. Follow it with: gh run watch'",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "TZ=Pacific/Auckland vitest run",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/filesystem": "^8.1.4",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/share": "^8.0.3",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/sql.js": "^1.4.11",
		"@types/uuid": "^10.0.0",
		"autoprefixer": "^10.4.27",
		"drizzle-kit": "^0.31.10",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"postcss": "^8.5.8",
		"sql.js": "^1.14.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"better-sqlite3": "^12.8.0",
		"drizzle-orm": "^0.45.2",
		"uuid": "^13.0.0",
		"workbox-precaching": "^7.4.0",
		"workbox-routing": "^7.4.0",
		"workbox-strategies": "^7.4.0"
	}
}
