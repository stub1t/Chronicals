{
	"name": "chronicals",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:mobile": "CHRONICALS_TARGET=mobile vite build",
		"android:sync": "npm run build:mobile && cap sync android",
		"android:open": "cap open android",
		"release": "gh workflow run android-release.yml --ref main && echo 'Started. Follow it with: gh run watch'",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "TZ=Pacific/Auckland vitest run",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.5.3",
