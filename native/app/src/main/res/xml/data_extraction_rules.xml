<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. The diary is never uploaded to Google's cloud backup;
  moving it to a new phone by cable or Wi-Fi (device to device transfer) still
  works. The backup export under Me is the way to keep a copy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
